# Copy this file to `.env` and fill the values. DO NOT commit real credentials to git.
# To enable SMTP, set DJANGO_EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend

# Email backend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP server (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
# For Gmail, create an App Password and use it here (not your account password)
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Sender shown in outgoing emails
DEFAULT_FROM_EMAIL=Your Name <your@gmail.com>

# Optional: SERVER_EMAIL (used for error emails)
# SERVER_EMAIL=your@gmail.com


